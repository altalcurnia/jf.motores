# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local a GitHub (ya está en .gitignore).

# URL pública del sitio (para metadatos y enlaces compartidos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Clave secreta: solo servidor. No la pegues en chats ni en código.
SUPABASE_SECRET_KEY=sb_secret_xxx

# WhatsApp de respaldo mientras los asesores no estén en la base de datos (formato internacional sin +)
NEXT_PUBLIC_WHATSAPP_FALLBACK=573122110262
